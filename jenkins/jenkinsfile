pipeline {
    agent any

    stages {
        stage('Unit Test Backend') {
            agent {
                docker {
                    image 'snakee/golang-junit:1.21'
                    reuseNode true // ca permet de ne pas recréer un container à chaque fois, mais de réutiliser le même pour les étapes suivantes
                }
            }
            environment {
                // Redirige le cache de compilation
                GOCACHE = '/tmp/go-cache'
                
                // Redirige le téléchargement des dépendances (modules)
                GOMODCACHE = '/tmp/go-mod-cache'
                GOPATH = '/tmp/go'
            }
            steps {
                dir('bugtracker-backend'){
                    sh 'go test ./... -v'
                }
            }
        }
    }
}
