pipeline {
    agent any

    stages {
        stage('Unit Test Backend') {
            agent {
                docker {
                    image 'snakee/golang-junit:1.21'
                    reuseNode true // ca permet de ne pas recréer un container à chaque fois, mais de réutiliser le même pour les étapes suivantes
                }
            }
            environment {
                // Redirige le cache de compilation
                GOCACHE = '/tmp/go-cache'
                
                // Redirige le téléchargement des dépendances (modules)
                GOMODCACHE = '/tmp/go-mod-cache'
                GOPATH = '/tmp/go'
            }
            steps {
                dir('bugtracker-backend'){
                    sh 'go test ./... -v 2>&1 | go-junit-report > test-results.xml'
                }
            }
            post {
                always {
                    junit 'bugtracker-backend/test-results.xml'
                }
            }

        }

        stage('Unit Test Frontend') {
            agent{
                docker {
                    image 'node:20-alpine'
                    reuseNode true // ca permet de ne pas recréer un container à chaque fois, mais de réutiliser le même pour les étapes suivantes
                }
            }
            steps {
                dir('bugtracker-frontend'){
                    sh '''
                        npm install
                        npm test
                    '''
                }   
            }
            post {
                always {
                    junit 'bugtracker-frontend/test-results.xml'
                }
            }
        }
    }
}
